# Copy this file to ".env" and fill in real values. NEVER commit ".env" (it is gitignored).
# On a host, set these in its environment-variable settings instead.

# Long random text, at least 32 characters. Signs the admin login cookie.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
MERIDIAN_SECRET=

# The admin (curator) login for /curator/login
MERIDIAN_ADMIN_EMAIL=
# At least 12 characters in production (8 locally). Use a long, unique password.
MERIDIAN_ADMIN_PASSWORD=

# Public canonical URL; set this in production for SEO and link previews.
SITE_URL=

# Optional inquiry email alerts. If omitted, enquiries remain available in the dealer desk.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Optional: use a sender address verified with Resend.
NOTIFY_FROM=

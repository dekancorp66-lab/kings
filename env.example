# Copy this file to ".env" and fill in real values. NEVER commit ".env" (it is gitignored).
# On a host (VPS / Vercel / Render) set the same three names in its "Environment variables" page.

# Long random text, at least 32 characters. Signs the admin login cookie.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
MERIDIAN_SECRET=

# The admin (curator) login for /curator/login
MERIDIAN_ADMIN_EMAIL=
# At least 8 characters. Use a long unique password. If empty, admin login stays disabled.
MERIDIAN_ADMIN_PASSWORD=
